{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://metwalley.local/schemas/nuqul-7-9.schema.json",
 "title": "Nuqul 7-9 Corpus — حول سن الحضانة والرعاية المشتركة بالمناصفة",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "meta",
  "axes",
  "entries"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "title",
    "owner",
    "version",
    "date",
    "charter",
    "legend"
   ],
   "properties": {
    "title": {
     "type": "string"
    },
    "owner": {
     "type": "string"
    },
    "version": {
     "type": "string",
     "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "date": {
     "type": "string",
     "format": "date"
    },
    "charter": {
     "type": "string",
     "description": "اسم ملف دستور العمل الحاكم"
    },
    "legend": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "supports",
      "confidence",
      "strength"
     ],
     "properties": {
      "supports": {
       "type": "object"
      },
      "confidence": {
       "type": "object"
      },
      "strength": {
       "type": "object"
      }
     }
    },
    "contributors": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "retired_ids": {
     "type": "array",
     "description": "معرّفات محجوزة لا يُعاد استعمالها (المادة 16)",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "id",
       "reason"
      ],
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^A[1-6]-\\d{3}$"
       },
       "reason": {
        "type": "string"
       }
      }
     }
    },
    "sections": {
     "type": "object",
     "description": "مفاتيح الأقسام الخمسة عشر وأسماؤها"
    },
    "section_order": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "changelog": {
     "type": "object",
     "description": "سجل التغييرات لكل إصدار"
    },
    "id_map_1_17": {
     "type": "object",
     "description": "المعرفات المؤقتة للنصوص المضافة في 1.16 ومقابلها الدائم"
    }
   }
  },
  "axes": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "title"
    ],
    "properties": {
     "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
     },
     "title": {
      "type": "string"
     }
    }
   }
  },
  "entries": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/entry"
   }
  }
 },
 "$defs": {
  "entry": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "axis",
    "category",
    "supports",
    "author",
    "work",
    "original",
    "translation_ar",
    "urls",
    "confidence",
    "strength",
    "argument",
    "jurisdiction"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^A[1-6]-\\d{3}$",
     "description": "A<محور>-<رقم ثلاثي>"
    },
    "axis": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6
    },
    "category": {
     "type": "string",
     "minLength": 1
    },
    "supports": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "enum": [
       "7",
       "9",
       "childhood_ends_at_puberty",
       "shared_parenting",
       "silat_al_rahim",
       "counter"
      ]
     }
    },
    "author": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "name"
     ],
     "properties": {
      "name": {
       "type": "string",
       "minLength": 1
      },
      "date": {
       "type": "string"
      }
     }
    },
    "work": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "title"
     ],
     "properties": {
      "title": {
       "type": "string"
      },
      "section": {
       "type": "string"
      },
      "volume": {
       "type": "string"
      },
      "page": {
       "type": "string"
      },
      "edition": {
       "type": "string"
      }
     }
    },
    "original": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "lang",
      "text",
      "verbatim"
     ],
     "properties": {
      "lang": {
       "type": "string",
       "pattern": "^[a-z]{2}$",
       "description": "ISO 639-1"
      },
      "text": {
       "type": "string",
       "minLength": 1
      },
      "verbatim": {
       "type": "boolean",
       "description": "true = منقول بلفظه؛ false = بالمعنى (يبدأ بـ «مضمونه»)"
      }
     }
    },
    "translation_ar": {
     "type": "string",
     "description": "إلزامي للنصّ غير العربي المنقول بلفظه"
    },
    "urls": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
     }
    },
    "confidence": {
     "enum": [
      "verified",
      "recalled",
      "not_found"
     ]
    },
    "strength": {
     "enum": [
      "explicit_7",
      "explicit_9",
      "explicit",
      "indirect",
      "contextual"
     ]
    },
    "argument": {
     "type": "string",
     "minLength": 20,
     "description": "وجه الاستدلال (مضمون البطاقة)، أو الجواب في المحور 6؛ لا يكون ملاحظة توثيقية"
    },
    "jurisdiction": {
     "type": "string",
     "minLength": 2,
     "description": "الدولة/الولاية/الهيئة، أو المذهب/الحقل للنصوص التراثية"
    },
    "notes": {
     "type": "string"
    },
    "title": {
     "type": [
      "string",
      "null"
     ],
     "description": "عنوان البطاقة"
    },
    "translation_en": {
     "type": "string",
     "description": "ترجمة عمل إنجليزية"
    },
    "about": {
     "type": "string",
     "description": "نبذة قصيرة بمكانة المصدر العلمية أو مكانة مؤلفه، تعرض داخل البطاقة"
    },
    "source_standing": {
     "type": "string",
     "description": "عن المصدر: منزلته العلمية أو القضائية"
    },
    "evidence_level": {
     "type": "string",
     "description": "درجة الدليل"
    },
    "section": {
     "type": [
      "string",
      "null"
     ],
     "description": "مفتاح القسم في الإصدار؛ null لمدخل غير معروض في البطاقات"
    },
    "card_number": {
     "type": [
      "integer",
      "null"
     ],
     "description": "رقم البطاقة في الإصدار"
    },
    "links": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "url",
       "label"
      ],
      "properties": {
       "url": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "site": {
        "type": "string"
       },
       "domain": {
        "type": "string"
       }
      }
     }
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "original": {
        "properties": {
         "verbatim": {
          "const": false
         }
        }
       }
      }
     },
     "then": {
      "properties": {
       "original": {
        "properties": {
         "text": {
          "pattern": "^مضمونه"
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "original": {
        "properties": {
         "lang": {
          "not": {
           "const": "ar"
          }
         },
         "verbatim": {
          "const": true
         }
        }
       }
      }
     },
     "then": {
      "properties": {
       "translation_ar": {
        "minLength": 1
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "confidence": {
        "const": "verified"
       }
      }
     },
     "then": {
      "properties": {
       "urls": {
        "minItems": 0
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "axis": {
        "const": 6
       }
      }
     },
     "then": {
      "properties": {
       "supports": {
        "contains": {
         "const": "counter"
        }
       }
      }
     }
    }
   ]
  }
 }
}